					pmk8550_rtc: rtc@6100 {
						compatible = "qcom,pmk8350-rtc";
						reg = <0x6100 0x6200>;
						reg-names = "rtc", "alarm";
						interrupts = <0x00 0x62 0x01 0x01>;
						qcom,no-alarm;
						qcom,uefi-rtc-info;
						phandle = <0x240>;
