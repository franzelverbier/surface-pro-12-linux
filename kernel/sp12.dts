	aliases {
		serial0 = "/soc@0/geniqup@bc0000/serial@b88000";
		serial1 = "/soc@0/geniqup@ac0000/serial@a98000";
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <0x194 0x00 0x4c4b40>;
		power-supply = <0x100>;
		phandle = <0xff>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x195 0x196 0x197>;
		pinctrl-names = "default";

		switch-lid {
			gpios = <0x57 0x02 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			wakeup-source;
			wakeup-event-action = <0x02>;
		};

		key-vol-up {
			gpios = <0x103 0x08 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};

		key-vol-down {
			gpios = <0x103 0x06 0x01>;
			linux,code = <0x72>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "qcom,x1e80100-pmic-glink", "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		orientation-gpios = <0x57 0x79 0x00 0x57 0x7b 0x00>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					pmic_glink_ss0_hs_in: endpoint {
						remote-endpoint = <0x198>;
						phandle = <0xdf>;
					};
				};

				port@1 {
					reg = <0x01>;

					pmic_glink_ss0_ss_in: endpoint {
						remote-endpoint = <0x199>;
						phandle = <0x99>;
					};
				};

				port@2 {
					reg = <0x02>;

					pmic_glink_ss0_sbu: endpoint {
						remote-endpoint = <0x19a>;
						phandle = <0x1ac>;
					};
				};
			};
		};

		connector@1 {
			compatible = "usb-c-connector";
			reg = <0x01>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					pmic_glink_ss1_hs_in: endpoint {
						remote-endpoint = <0x19b>;
						phandle = <0xe2>;
					};
				};

				port@1 {
					reg = <0x01>;

					pmic_glink_ss1_ss_in: endpoint {
						remote-endpoint = <0x19c>;
						phandle = <0x9e>;
					};
				};

				port@2 {
					reg = <0x02>;

					pmic_glink_ss1_sbu: endpoint {
						remote-endpoint = <0x19d>;
						phandle = <0x1ae>;
					};
				};
			};
		};
	};

	vreg_edp_3p3: regulator-edp-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_EDP_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x57 0x46 0x00>;
		enable-active-high;
		pinctrl-0 = <0x19e>;
		pinctrl-names = "default";
		regulator-boot-on;
		vin-supply = <0x19f>;
		phandle = <0x100>;
	};

	vreg_panel_en: regulator-panel-en {
		compatible = "regulator-fixed";
		regulator-name = "VREG_PANEL_EN";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x57 0x1d 0x00>;
		enable-active-high;
		regulator-enable-ramp-delay = <0x249f0>;
		pinctrl-0 = <0x1a0>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0x19f>;
	};

	vph_pwr: regulator-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		phandle = <0x178>;
	};

	vreg_wcn_0p95: regulator-wcn-0p95 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WCN_0P95";
		regulator-min-microvolt = <0xe7ef0>;
		regulator-max-microvolt = <0xe7ef0>;
		vin-supply = <0x1a1>;
		phandle = <0x1a8>;
	};

	vreg_wcn_1p9: regulator-wcn-1p9 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WCN_1P9";
		regulator-min-microvolt = <0x1cfde0>;
		regulator-max-microvolt = <0x1cfde0>;
		vin-supply = <0x1a1>;
		phandle = <0x1a9>;
	};

	vreg_wcn_3p3: regulator-wcn-3p3 {
		compatible = "regulator-fixed";
		regulator-name = "VREG_WCN_3P3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x57 0xd6 0x00>;
		enable-active-high;
		pinctrl-0 = <0x1a2>;
		pinctrl-names = "default";
		phandle = <0x1a1>;
	};

	sound {
		compatible = "qcom,x1e80100-sndcard";
		model = "X1P42100-Microsoft-Surface-Pro-12in";
		audio-routing = "SpkrLeft IN", "WSA WSA_SPK1 OUT", "SpkrRight IN", "WSA WSA_SPK2 OUT", "VA DMIC0", "vdd-micb", "VA DMIC1", "vdd-micb";

		va-dai-link {
			link-name = "VA Capture";

			codec {
				sound-dai = <0xc1 0x00>;
			};

			cpu {
				sound-dai = <0x1a3 0x6e>;
			};

			platform {
				sound-dai = <0x1a4>;
			};
		};

		wsa-dai-link {
			link-name = "WSA Playback";

			codec {
				sound-dai = <0x1a5 0x1a6 0x1a7 0x00 0xc7 0x00>;
			};

			cpu {
				sound-dai = <0x1a3 0x69>;
			};

			platform {
				sound-dai = <0x1a4>;
			};
		};
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";
		vdd-supply = <0x1a8>;
		vddio-supply = <0x58>;
		vddaon-supply = <0x1a8>;
		vdddig-supply = <0x1a8>;
		vddrfa1p2-supply = <0x1a9>;
		vddrfa1p8-supply = <0x1a9>;
		wlan-enable-gpios = <0x57 0x75 0x00>;
		bt-enable-gpios = <0x57 0x74 0x00>;
		pinctrl-0 = <0x1aa>;
		pinctrl-names = "default";

		regulators {

			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x72>;
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x6f>;
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x70>;
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x71>;
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
				phandle = <0x286>;
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x73>;
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x74>;
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x75>;
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0xaa>;
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0xab>;
			};
		};
	};

	usb-1-ss0-sbu-mux {
		compatible = "onnn,fsusb42", "gpio-sbu-mux";
		enable-gpios = <0x57 0xa8 0x01>;
		select-gpios = <0x57 0xa7 0x00>;
		pinctrl-0 = <0x1ab>;
		pinctrl-names = "default";
		mode-switch;
		orientation-switch;

		port {

			usb_1_ss0_sbu_mux: endpoint {
				remote-endpoint = <0x1ac>;
				phandle = <0x19a>;
			};
		};
	};

	usb-1-ss1-sbu-mux {
		compatible = "onnn,fsusb42", "gpio-sbu-mux";
		enable-gpios = <0x57 0xb3 0x01>;
		select-gpios = <0x57 0xb2 0x00>;
		pinctrl-0 = <0x1ad>;
		pinctrl-names = "default";
		mode-switch;
		orientation-switch;

		port {

			usb_1_ss1_sbu_mux: endpoint {
				remote-endpoint = <0x1ae>;
				phandle = <0x19d>;
			};
		};
	};

