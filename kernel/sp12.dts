/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Surface Pro 12in 1st Edition";
	compatible = "microsoft,surface-pro-12in", "qcom,x1p42100";
	chassis-type = "tablet";

	chosen {
	};

	clocks {

		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <0x493e000>;
			#clock-cells = <0x00>;
			phandle = <0x176>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <0x7ffc>;
			#clock-cells = <0x00>;
			phandle = <0x29>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x02 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x28>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x02 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0xea>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x00>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			power-domains = <0x04 0x05 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x0e>;

			l2_0: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x03>;
			};
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x100>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			power-domains = <0x06 0x05 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x0f>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x200>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			power-domains = <0x07 0x05 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x10>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x300>;
			enable-method = "psci";
			next-level-cache = <0x03>;
			power-domains = <0x08 0x05 0x00>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x11>;
		};

		cpu4: cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0a 0x05 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x12>;

			l2_1: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x09>;
			};
		};

		cpu5: cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0b 0x05 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x13>;
		};

		cpu6: cpu@10200 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10200>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0c 0x05 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x14>;
		};

		cpu7: cpu@10300 {
			device_type = "cpu";
			compatible = "qcom,oryon";
			reg = <0x00 0x10300>;
			enable-method = "psci";
			next-level-cache = <0x09>;
			power-domains = <0x0d 0x05 0x01>;
			power-domain-names = "psci", "perf";
			#cooling-cells = <0x02>;
			phandle = <0x15>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x12>;
				};

				core1 {
					cpu = <0x13>;
				};

				core2 {
					cpu = <0x14>;
				};

				core3 {
					cpu = <0x15>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cluster_c4: cpu-sleep-0 {
				compatible = "arm,idle-state";
				idle-state-name = "ret";
				arm,psci-suspend-param = <0x04>;
				entry-latency-us = <0xb4>;
				exit-latency-us = <0x140>;
				min-residency-us = <0x258>;
				phandle = <0x1f>;
			};
		};

		domain-idle-states {

			cluster_cl4: cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000044>;
				entry-latency-us = <0x15e>;
				exit-latency-us = <0x1f4>;
				min-residency-us = <0x9c4>;
				phandle = <0x21>;
			};

			cluster_cl5: cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x1000054>;
				entry-latency-us = <0x898>;
				exit-latency-us = <0xfa0>;
				min-residency-us = <0x1b58>;
				phandle = <0x22>;
			};
		};
	};

	dummy-sink {
		compatible = "arm,coresight-dummy-sink";

		in-ports {

			port {

				eud_in: endpoint {
					remote-endpoint = <0x16>;
					phandle = <0x132>;
				};
			};
		};
	};

	firmware {

		scm: scm {
			compatible = "qcom,scm-x1e80100", "qcom,scm";
			interconnects = <0x17 0x02 0x07 0x18 0x01 0x07>;
			qcom,dload-mode = <0x19 0x19000>;
			phandle = <0x1af>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <0x1a 0x00 0x1a 0x02>;
			mbox-names = "tx", "rx";
			shmem = <0x1b 0x1c>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			scmi_dvfs: protocol@13 {
				reg = <0x13>;
				#power-domain-cells = <0x01>;
				phandle = <0x05>;
			};
		};
	};

	clk_virt: interconnect-0 {
		compatible = "qcom,x1e80100-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1d>;
		phandle = <0x35>;
	};

	mc_virt: interconnect-1 {
		compatible = "qcom,x1e80100-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x1d>;
		phandle = <0x18>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x00>;
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x07 0x08>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";

		cpu_pd0: power-domain-cpu0 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			phandle = <0x04>;
		};

		cpu_pd1: power-domain-cpu1 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			phandle = <0x06>;
		};

		cpu_pd2: power-domain-cpu2 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			phandle = <0x07>;
		};

		cpu_pd3: power-domain-cpu3 {
			#power-domain-cells = <0x00>;
			power-domains = <0x1e>;
			domain-idle-states = <0x1f>;
			phandle = <0x08>;
		};

		cpu_pd4: power-domain-cpu4 {
			#power-domain-cells = <0x00>;
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			phandle = <0x0a>;
		};

		cpu_pd5: power-domain-cpu5 {
			#power-domain-cells = <0x00>;
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			phandle = <0x0b>;
		};

		cpu_pd6: power-domain-cpu6 {
			#power-domain-cells = <0x00>;
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			phandle = <0x0c>;
		};

		cpu_pd7: power-domain-cpu7 {
			#power-domain-cells = <0x00>;
			power-domains = <0x20>;
			domain-idle-states = <0x1f>;
			phandle = <0x0d>;
		};

		cluster_pd0: power-domain-cpu-cluster0 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x21 0x22>;
			power-domains = <0x23>;
			phandle = <0x1e>;
		};

		cluster_pd1: power-domain-cpu-cluster1 {
			#power-domain-cells = <0x00>;
			domain-idle-states = <0x21 0x22>;
			power-domains = <0x23>;
			phandle = <0x20>;
		};

		system_pd: power-domain-system {
			#power-domain-cells = <0x00>;
			phandle = <0x23>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		gunyah_hyp_mem: gunyah-hyp@80000000 {
			reg = <0x00 0x80000000 0x00 0x800000>;
			no-map;
			phandle = <0x1b0>;
		};

		hyp_elf_package_mem: hyp-elf-package@80800000 {
			reg = <0x00 0x80800000 0x00 0x200000>;
			no-map;
			phandle = <0x1b1>;
		};

		ncc_mem: ncc@80a00000 {
			reg = <0x00 0x80a00000 0x00 0x400000>;
			no-map;
			phandle = <0x1b2>;
		};

		cpucp_log_mem: cpucp-log@80e00000 {
			reg = <0x00 0x80e00000 0x00 0x40000>;
			no-map;
			phandle = <0x1b3>;
		};

		cpucp_mem: cpucp@80e40000 {
			reg = <0x00 0x80e40000 0x00 0x540000>;
			no-map;
			phandle = <0x1b4>;
		};

		reserved-region@81380000 {
			reg = <0x00 0x81380000 0x00 0x80000>;
			no-map;
		};

		tags_mem: tags-region@81400000 {
			reg = <0x00 0x81400000 0x00 0x1a0000>;
			no-map;
			phandle = <0x1b5>;
		};

		xbl_dtlog_mem: xbl-dtlog@81a00000 {
			reg = <0x00 0x81a00000 0x00 0x40000>;
			no-map;
			phandle = <0x1b6>;
		};

		xbl_ramdump_mem: xbl-ramdump@81a40000 {
			reg = <0x00 0x81a40000 0x00 0x1c0000>;
			no-map;
			phandle = <0x1b7>;
		};

		aop_image_mem: aop-image@81c00000 {
			reg = <0x00 0x81c00000 0x00 0x60000>;
			no-map;
			phandle = <0x1b8>;
		};

		aop_cmd_db_mem: aop-cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			reg = <0x00 0x81c60000 0x00 0x20000>;
			no-map;
			phandle = <0x1b9>;
		};

		aop_config_mem: aop-config@81c80000 {
			reg = <0x00 0x81c80000 0x00 0x20000>;
			no-map;
			phandle = <0x1ba>;
		};

		tme_crash_dump_mem: tme-crash-dump@81ca0000 {
			reg = <0x00 0x81ca0000 0x00 0x40000>;
			no-map;
			phandle = <0x1bb>;
		};

		tme_log_mem: tme-log@81ce0000 {
			reg = <0x00 0x81ce0000 0x00 0x4000>;
			no-map;
			phandle = <0x1bc>;
		};

		uefi_log_mem: uefi-log@81ce4000 {
			reg = <0x00 0x81ce4000 0x00 0x10000>;
			no-map;
			phandle = <0x1bd>;
		};

		secdata_apss_mem: secdata-apss@81cff000 {
			reg = <0x00 0x81cff000 0x00 0x1000>;
			no-map;
			phandle = <0x1be>;
		};

		pdp_ns_shared_mem: pdp-ns-shared@81e00000 {
			reg = <0x00 0x81e00000 0x00 0x100000>;
			no-map;
			phandle = <0x1bf>;
		};

		gpu_prr_mem: gpu-prr@81f00000 {
			reg = <0x00 0x81f00000 0x00 0x10000>;
			no-map;
			phandle = <0x1c0>;
		};

		tpm_control_mem: tpm-control@81f10000 {
			reg = <0x00 0x81f10000 0x00 0x10000>;
			no-map;
			phandle = <0x1c1>;
		};

		usb_ucsi_shared_mem: usb-ucsi-shared@81f20000 {
			reg = <0x00 0x81f20000 0x00 0x10000>;
			no-map;
			phandle = <0x1c2>;
		};

		pld_pep_mem: pld-pep@81f30000 {
			reg = <0x00 0x81f30000 0x00 0x6000>;
			no-map;
			phandle = <0x1c3>;
		};

		pld_gmu_mem: pld-gmu@81f36000 {
			reg = <0x00 0x81f36000 0x00 0x1000>;
			no-map;
			phandle = <0x1c4>;
		};

		pld_pdp_mem: pld-pdp@81f37000 {
			reg = <0x00 0x81f37000 0x00 0x1000>;
			no-map;
			phandle = <0x1c5>;
		};

		tz_stat_mem: tz-stat@82700000 {
			reg = <0x00 0x82700000 0x00 0x100000>;
			no-map;
			phandle = <0x1c6>;
		};

		xbl_tmp_buffer_mem: xbl-tmp-buffer@82800000 {
			reg = <0x00 0x82800000 0x00 0xc00000>;
			no-map;
			phandle = <0x1c7>;
		};

		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap@84b00000 {
			reg = <0x00 0x84b00000 0x00 0x800000>;
			no-map;
			phandle = <0x1c8>;
		};

		spu_secure_shared_memory_mem: spu-secure-shared-memory@85300000 {
			reg = <0x00 0x85300000 0x00 0x80000>;
			no-map;
			phandle = <0x1c9>;
		};

		adsp_boot_dtb_mem: adsp-boot-dtb@866c0000 {
			reg = <0x00 0x866c0000 0x00 0x40000>;
			no-map;
			phandle = <0x1ca>;
		};

		spss_region_mem: spss-region@86700000 {
			reg = <0x00 0x86700000 0x00 0x400000>;
			no-map;
			phandle = <0x1cb>;
		};

		adsp_boot_mem: adsp-boot@86b00000 {
			reg = <0x00 0x86b00000 0x00 0xc00000>;
			no-map;
			phandle = <0x1cc>;
		};

		video_mem: video@87700000 {
			reg = <0x00 0x87700000 0x00 0x700000>;
			no-map;
			phandle = <0xe7>;
		};

		adspslpi_mem: adspslpi@87e00000 {
			reg = <0x00 0x87e00000 0x00 0x3a00000>;
			no-map;
			phandle = <0xbd>;
		};

		q6_adsp_dtb_mem: q6-adsp-dtb@8b800000 {
			reg = <0x00 0x8b800000 0x00 0x80000>;
			no-map;
			phandle = <0xbe>;
		};

		cdsp_mem: cdsp@8b900000 {
			reg = <0x00 0x8b900000 0x00 0x2000000>;
			no-map;
			phandle = <0x181>;
		};

		q6_cdsp_dtb_mem: q6-cdsp-dtb@8d900000 {
			reg = <0x00 0x8d900000 0x00 0x80000>;
			no-map;
			phandle = <0x182>;
		};

		gpu_microcode_mem: gpu-microcode@8d9fe000 {
			reg = <0x00 0x8d9fe000 0x00 0x2000>;
			no-map;
			phandle = <0xb7>;
		};

		cvp_mem: cvp@8da00000 {
			reg = <0x00 0x8da00000 0x00 0x700000>;
			no-map;
			phandle = <0x1cd>;
		};

		camera_mem: camera@8e100000 {
			reg = <0x00 0x8e100000 0x00 0x800000>;
			no-map;
			phandle = <0x1ce>;
		};

		av1_encoder_mem: av1-encoder@8e900000 {
			reg = <0x00 0x8e900000 0x00 0x700000>;
			no-map;
			phandle = <0x1cf>;
		};

		reserved-region@8f000000 {
			reg = <0x00 0x8f000000 0x00 0xa00000>;
			no-map;
		};

		wpss_mem: wpss@8fa00000 {
			reg = <0x00 0x8fa00000 0x00 0x1900000>;
			no-map;
			phandle = <0x1d0>;
		};

		q6_wpss_dtb_mem: q6-wpss-dtb@91300000 {
			reg = <0x00 0x91300000 0x00 0x80000>;
			no-map;
			phandle = <0x1d1>;
		};

		xbl_sc_mem: xbl-sc@d8000000 {
			reg = <0x00 0xd8000000 0x00 0x40000>;
			no-map;
			phandle = <0x1d2>;
		};

		reserved-region@d8040000 {
			reg = <0x00 0xd8040000 0x00 0xa0000>;
			no-map;
		};

		qtee_mem: qtee@d80e0000 {
			reg = <0x00 0xd80e0000 0x00 0x520000>;
			no-map;
			phandle = <0x1d3>;
		};

		ta_mem: ta@d8600000 {
			reg = <0x00 0xd8600000 0x00 0x8a00000>;
			no-map;
			phandle = <0x1d4>;
		};

		tags_mem1: tags@e1000000 {
			reg = <0x00 0xe1000000 0x00 0x26a0000>;
			no-map;
			phandle = <0x1d5>;
		};

		llcc_lpi_mem: llcc-lpi@ff800000 {
			reg = <0x00 0xff800000 0x00 0x600000>;
			no-map;
			phandle = <0x1d6>;
		};

		smem_mem: smem@ffe00000 {
			compatible = "qcom,smem";
			reg = <0x00 0xffe00000 0x00 0x200000>;
			hwlocks = <0x24 0x03>;
			no-map;
			phandle = <0x1d7>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			size = <0x00 0x20000000>;
			reusable;
			linux,cma-default;
		};
	};

	qup_opp_table_100mhz: opp-table-qup100mhz {
		compatible = "operating-points-v2";
		phandle = <0x41>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x25>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x26>;
		};
	};

	qup_opp_table_120mhz: opp-table-qup120mhz {
		compatible = "operating-points-v2";
		phandle = <0x3a>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x25>;
		};

		opp-120000000 {
			opp-hz = <0x00 0x7270e00>;
			required-opps = <0x26>;
		};
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x27 0x03 0x02 0x01>;
		mboxes = <0x27 0x03 0x02>;
		qcom,smem = <0x1bb 0x1ad>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		smp2p_adsp_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0xbf>;
		};

		smp2p_adsp_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0xbb>;
		};
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		interrupts-extended = <0x27 0x06 0x02 0x01>;
		mboxes = <0x27 0x06 0x02>;
		qcom,smem = <0x5e 0x1b0>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		smp2p_cdsp_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x183>;
		};

		smp2p_cdsp_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x17f>;
		};
	};

	soc: soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		dma-ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;
		ranges = <0x00 0x00 0x00 0x00 0x100 0x00>;
		phandle = <0x1d8>;

		gcc: clock-controller@100000 {
			compatible = "qcom,x1p42100-gcc", "qcom,x1e80100-gcc";
			reg = <0x00 0x100000 0x00 0x200000>;
			clocks = <0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x00 0x2e 0x00 0x2f 0x00 0x30 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x31 0x00 0x31 0x01 0x31 0x02>;
			power-domains = <0x32 0x00>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			phandle = <0x34>;
		};

		ipcc: mailbox@408000 {
			compatible = "qcom,x1e80100-ipcc", "qcom,ipcc";
			reg = <0x00 0x408000 0x00 0x1000>;
			interrupts = <0x00 0xe5 0x04>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			#mbox-cells = <0x02>;
			phandle = <0x27>;
		};

		gpi_dma2: dma-controller@800000 {
