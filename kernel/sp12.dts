					slew-rate = <0x01>;
					bias-bus-hold;
				};
			};

			dmic01_default: dmic01-default-state {
				phandle = <0xd0>;

				clk-pins {
					pins = "gpio6";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				data-pins {
					pins = "gpio7";
					function = "dmic1_data";
					drive-strength = <0x08>;
					input-enable;
				};
