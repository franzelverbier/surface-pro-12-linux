# Différences device tree : EL1 -> EL2 (Surface Pro 12, x1p42100)
#
# Le DTB compile correspondant est publie ici : kernel/sp12-el2.dtb
# (identique a celui reellement demarre sur la machine).
#
# Diff entre le DTS de fonctionnement normal (EL1) et celui utilisé pour démarrer
# en EL2 avec KVM. Onze modifications, toutes nécessaires ; le reste du DTS est
# identique. À appliquer sur votre propre DTS aplati (`dtc -I dtb -O dts`).
#
#  1. chosen/dtbhack-el2-overlay = "x1e-el2"
#     Marqueur repris de l'overlay amont x1-el2.
#
#  2/3. pcie6a et pcie4 : iommu-map vers le SMMUv3 (phandle 0x25b)
#     Sans ces entrées, les requêtes PCIe ne sont pas traduites.
#
#  4. gpu/zap-shader : status = "disabled"
#     slbounce REFUSE de basculer en EL2 tant que le zap-shader est actif.
#
#  5/10. remoteproc_adsp et remoteproc_cdsp : qcom,broken-reset
#     Fait choisir qcom_pas_ops_no_reset (attach seul, ni start ni load), donc
#     le SMC PAS qui renvoie -22 en EL2 n'est jamais appelé. Indispensable pour
#     l'audio, en complément de qebspil. Voir EL2-KVM.md.
#
#     ⚠️ Coût à connaître : si un DSP plante en fonctionnement, le noyau prend
#     un oops (déréférencement nul dans rproc_start, ops->start étant absent de
#     qcom_pas_ops_no_reset) et le DSP reste offline jusqu'au redémarrage.
#     Constaté sur le CDSP le 2026-08-11. Détail complet et piste de correctif
#     dans patches/audio-el2-serie.md.
#
#  6. iris (video-codec) : status = "disabled"
#     Le décodeur vidéo ne survit pas à la bascule.
#
#  7. pcie_smmu (iommu@15400000) : "reserved" -> "okay"     <<< LE correctif MSI
#     Laissé en "reserved", aucune MSI n'est délivrée : tous les compteurs
#     ITS-PCI-MSI restent à zéro et le WiFi interne est inutilisable.
#     Attention : arm-smmu.force_stage=1 ne teste PAS ce composant (c'est le
#     paramètre du pilote SMMUv1/v2), il ne permet donc pas de l'écarter.
#
#  8. reserved-memory/ramoops@a0000000 : zone de capture de plantage
#     Sans elle, pstore reste vide et un plantage noyau ne laisse aucune trace.
#     Deux redemarrages inexpliques (1er et 2 aout 2026) l'ont montre. 0xa0000000
#     est dans System RAM sans reservation concurrente, verifie en EL2.
#
#  9. apss_watchdog : "reserved" -> "okay"
#  9. sbsa_watchdog : status = "disabled"
#     En EL2, c'est Linux qui possède le watchdog APSS ; le SBSA doit céder.
#
# 11. pmk8550_rtc : qcom,rtc-offset -- l'horloge matérielle
#     Nécessite le correctif hors-arbre patches/0008 (rtc: pm8xxx).
#
#     En EL2, les variables EFI sont perdues. Le mécanisme, mesuré et non
#     supposé : après Secure Launch, TrustZone répond encore à la requête de
#     version (TZ_OWNER_SIP / INFO_VERSION renvoie 0x1402000) mais refuse le
#     gestionnaire de trustlets (TZ_OWNER_QSEE_OS / APP_LOOKUP échoue en -22).
#     Donc qcom_qseecom_uefisecapp ne sonde jamais, efivars ne s'enregistre pas
#     (0 variable, contre 110 en EL1 avec le même noyau), et qcomtee annonce
#     « QTEE version 0.0.0 » au lieu de 5.2.0. Mainline ne sait pas recharger un
#     trustlet : c'est une impasse constatée, pas une piste non explorée.
#
#     Conséquence pour le RTC : pm8xxx_rtc_probe_offset() lit son décalage
#     d'époque dans la variable UEFI RTCInfo, et si efivars est absent il
#     renvoie -EPROBE_DEFER **sans échappatoire** tant que CONFIG_EFI=y. Le RTC
#     ne s'enregistre alors jamais — pas de /dev/rtc0, pas d'heure avant le NTP.
#
#     La propriété fournit une troisième source, testée après nvmem et avant
#     UEFI. Le décalage vaut (heure unix - compteur brut) et reste constant tant
#     que le PMIC compte.
#
#     La voie nvmem (celle qu'utilisent sc8280xp-crd, -arcata et -blackrock avec
#     une cellule rtc_offset@bc) n'est PAS transposable ici : sur le pmk8550 la
#     fenêtre utilisable d'un SDAM est 0x40..0x7f — 0xbc n'est pas adressable —
#     et le SDAM 6 est densément écrit par le firmware. Écrire dans une mémoire
#     persistante que le firmware s'approprie, sur la foi d'une inférence,
#     n'était pas acceptable.
#
#     Pour obtenir la valeur : démarrer une fois en EL1, où la branche UEFI
#     fonctionne, et lire le dev_info ajouté par le correctif 0008.
#
#     ⚠️ Si la batterie du PMIC se vide entièrement, le compteur brut repart et
#     la valeur devient fausse SANS AUCUN MESSAGE : l'heure sera simplement
#     décalée. Remède : refaire le relevé en EL1.
#
@@ -9,6 +9,7 @@
 	chassis-type = "tablet";
 
 	chosen {
+		dtbhack-el2-overlay = "x1e-el2";
 	};
 
 	clocks {
@@ -386,6 +387,22 @@
 		#size-cells = <0x02>;
 		ranges;
 
+		/*
+		 * Capture des plantages. Sans cette zone, pstore reste vide et un
+		 * plantage noyau ne laisse AUCUNE trace -- c'est ce qui a rendu deux
+		 * redemarrages inexpliquables les 1er et 2 aout 2026.
+		 * 0xa0000000 est dans System RAM (91480000-a7f00fff) sans reservation
+		 * concurrente, verifie sur machine vivante en EL2.
+		 * Relire apres un plantage : /sys/fs/pstore/
+		 */
+		ramoops@a0000000 {
+			compatible = "ramoops";
+			reg = <0x00 0xa0000000 0x00 0x100000>;
+			console-size = <0x40000>;
+			pmsg-size = <0x20000>;
+			ecc-size = <0x10>;
+		};
+
 		gunyah_hyp_mem: gunyah-hyp@80000000 {
 			reg = <0x00 0x80000000 0x00 0x800000>;
 			no-map;
@@ -2401,6 +2418,7 @@
 		};
 
 		pcie6a: pci@1bf8000 {
+			iommu-map = <0x00 0x25b 0x60000 0x10000>;
 			device_type = "pci";
 			compatible = "qcom,pcie-x1e80100";
 			reg = <0x00 0x1bf8000 0x00 0x3000 0x00 0x70000000 0x00 0xf20 0x00 0x70000f40 0x00 0xa8 0x00 0x70001000 0x00 0x1000 0x00 0x70100000 0x00 0x100000 0x00 0x1bfb000 0x00 0x1000>;
@@ -2524,6 +2542,7 @@
 		};
 
 		pcie4: pci@1c08000 {
+			iommu-map = <0x00 0x25b 0x40000 0x10000>;
 			device_type = "pci";
 			compatible = "qcom,pcie-x1e80100";
 			reg = <0x00 0x1c08000 0x00 0x3000 0x00 0x7c000000 0x00 0xf1d 0x00 0x7c000f40 0x00 0xa8 0x00 0x7c001000 0x00 0x1000 0x00 0x7c100000 0x00 0x100000 0x00 0x1c0b000 0x00 0x1000>;
@@ -2725,6 +2744,7 @@
 			phandle = <0x188>;
 
 			gpu_zap_shader: zap-shader {
+				status = "disabled";
 				memory-region = <0xb7>;
 				firmware-name = "qcom/x1p42100/Microsoft/Surface12/qcdxkmsucpurwa.mbn";
 				phandle = <0x21e>;
@@ -2903,6 +2923,7 @@
 		};
 
 		remoteproc_adsp: remoteproc@6800000 {
+			qcom,broken-reset;
 			compatible = "qcom,x1e80100-adsp-pas";
 			reg = <0x00 0x6800000 0x00 0x10000>;
 			interrupts-extended = <0x94 0x06 0x01 0xbb 0x00 0x01 0xbb 0x01 0x01 0xbb 0x02 0x01 0xbb 0x03 0x01>;
@@ -3775,7 +3796,7 @@
 			reset-names = "bus";
 			iommus = <0x33 0x1940 0x00 0x33 0x1947 0x00>;
 			dma-coherent;
-			status = "okay";
+			status = "disabled";
 			firmware-name = "qcom/x1p42100/Microsoft/Surface12/qcvss8380_pa.mbn";
 			phandle = <0x231>;
 
@@ -4292,6 +4313,42 @@
 						interrupts = <0x00 0x62 0x01 0x01>;
 						qcom,no-alarm;
 						qcom,uefi-rtc-info;
+						/*
+						 * Decalage statique = 1749233531 (0x68432f7b).
+						 * Necessaire UNIQUEMENT en EL2 : apres Secure Launch,
+						 * TrustZone repond a la requete de version mais refuse
+						 * APP_LOOKUP (TZ_OWNER_QSEE_OS), donc uefisecapp ne sonde
+						 * jamais, efivars ne s'enregistre pas, et la branche UEFI
+						 * de pm8xxx_rtc_probe_offset() renvoie -EPROBE_DEFER
+						 * indefiniment : elle n'a aucune echappatoire tant que
+						 * CONFIG_EFI=y. Cette propriete est testee AVANT elle.
+						 * Necessite le correctif hors-arbre rtc-pm8xxx.
+						 *
+						 * Valeur relevee le 2026-08-05 sur un demarrage EL1, ou la
+						 * branche UEFI fonctionne (110 variables) :
+						 *   heure posee  1785954804
+						 *   moins offset 1749233527
+						 *   compteur brut  36721277 s = 425 j, coherent.
+						 *
+						 * Puis +4 s de correction. L'offset stocke par l'UEFI est
+						 * lui-meme en retard de 4,04 s sur l'heure reelle, mesure au
+						 * front de seconde du RTC contre une horloge NTP synchronisee.
+						 * Ce n'est pas un defaut de la methode : update_offset() ne
+						 * reecrit qu'au-dela de 30 s de derive, donc Windows tolere
+						 * cet ecart et nous l'avions fidelement recopie.
+						 *
+						 * Le decalage est constant tant que le PMIC compte. Si sa
+						 * batterie se vide entierement, le compteur repart et cette
+						 * valeur devient fausse SANS AUCUN MESSAGE : l'heure sera
+						 * simplement decalee. Remede : redemarrer en EL1 et relire
+						 * le dev_info du pilote.
+						 *
+						 * Uefi-rtc-info est conserve a dessein : en EL1 ce DTB n'est
+						 * pas utilise, et si un jour efivars revenait en EL2, il
+						 * suffirait de retirer la ligne ci-dessous pour repasser a
+						 * la source dynamique.
+						 */
+						qcom,rtc-offset = <0x68432f7b>;
 						phandle = <0x240>;
 					};
 
@@ -7121,7 +7142,7 @@
 			interrupts = <0x00 0x8a 0x01 0x00 0x86 0x01 0x00 0x88 0x01>;
 			interrupt-names = "eventq", "gerror", "cmdq-sync";
 			dma-coherent;
-			status = "reserved";
+			status = "okay";
 			phandle = <0x25b>;
 		};
 
@@ -7152,7 +7173,7 @@
 			reg = <0x00 0x17410000 0x00 0x1000>;
 			clocks = <0x29>;
 			interrupts = <0x00 0x00 0x01>;
-			status = "reserved";
+			status = "okay";
 			phandle = <0x25c>;
 		};
 
