# Différences device tree : EL1 -> EL2 (Surface Pro 12, x1p42100)
#
# Diff entre le DTS de fonctionnement normal (EL1) et celui utilisé pour démarrer
# en EL2 avec KVM. Dix modifications, toutes nécessaires ; le reste du DTS est
# identique. À appliquer sur votre propre DTS aplati (`dtc -I dtb -O dts`).
#
#  1. chosen/dtbhack-el2-overlay = "x1e-el2"
#     Marqueur repris de l'overlay amont x1-el2.
#
#  2/3. pcie6a et pcie4 : iommu-map vers le SMMUv3 (phandle 0x25b)
#     Sans ces entrées, les requêtes PCIe ne sont pas traduites.
#
#  4. gpu/zap-shader : status = "disabled"
#     slbounce REFUSE de basculer en EL2 tant que le zap-shader est actif.
#
#  5/10. remoteproc_adsp et remoteproc_cdsp : qcom,broken-reset
#     Fait choisir qcom_pas_ops_no_reset (attach seul, ni start ni load), donc
#     le SMC PAS qui renvoie -22 en EL2 n'est jamais appelé. Indispensable pour
#     l'audio, en complément de qebspil. Voir EL2-KVM.md.
#
#  6. iris (video-codec) : status = "disabled"
#     Le décodeur vidéo ne survit pas à la bascule.
#
#  7. pcie_smmu (iommu@15400000) : "reserved" -> "okay"     <<< LE correctif MSI
#     Laissé en "reserved", aucune MSI n'est délivrée : tous les compteurs
#     ITS-PCI-MSI restent à zéro et le WiFi interne est inutilisable.
#     Attention : arm-smmu.force_stage=1 ne teste PAS ce composant (c'est le
#     paramètre du pilote SMMUv1/v2), il ne permet donc pas de l'écarter.
#
#  8. apss_watchdog : "reserved" -> "okay"
#  9. sbsa_watchdog : status = "disabled"
#     En EL2, c'est Linux qui possède le watchdog APSS ; le SBSA doit céder.
#
@@ -9,6 +9,7 @@
 	chassis-type = "tablet";
 
 	chosen {
+		dtbhack-el2-overlay = "x1e-el2";
 	};
 
 	clocks {
@@ -2401,6 +2402,7 @@
 		};
 
 		pcie6a: pci@1bf8000 {
+			iommu-map = <0x00 0x25b 0x60000 0x10000>;
 			device_type = "pci";
 			compatible = "qcom,pcie-x1e80100";
 			reg = <0x00 0x1bf8000 0x00 0x3000 0x00 0x70000000 0x00 0xf20 0x00 0x70000f40 0x00 0xa8 0x00 0x70001000 0x00 0x1000 0x00 0x70100000 0x00 0x100000 0x00 0x1bfb000 0x00 0x1000>;
@@ -2524,6 +2526,7 @@
 		};
 
 		pcie4: pci@1c08000 {
+			iommu-map = <0x00 0x25b 0x40000 0x10000>;
 			device_type = "pci";
 			compatible = "qcom,pcie-x1e80100";
 			reg = <0x00 0x1c08000 0x00 0x3000 0x00 0x7c000000 0x00 0xf1d 0x00 0x7c000f40 0x00 0xa8 0x00 0x7c001000 0x00 0x1000 0x00 0x7c100000 0x00 0x100000 0x00 0x1c0b000 0x00 0x1000>;
@@ -2725,6 +2728,7 @@
 			phandle = <0x188>;
 
 			gpu_zap_shader: zap-shader {
+				status = "disabled";
 				memory-region = <0xb7>;
 				firmware-name = "qcom/x1p42100/Microsoft/Surface12/qcdxkmsucpurwa.mbn";
 				phandle = <0x21e>;
@@ -2903,6 +2907,7 @@
 		};
 
 		remoteproc_adsp: remoteproc@6800000 {
+			qcom,broken-reset;
 			compatible = "qcom,x1e80100-adsp-pas";
 			reg = <0x00 0x6800000 0x00 0x10000>;
 			interrupts-extended = <0x94 0x06 0x01 0xbb 0x00 0x01 0xbb 0x01 0x01 0xbb 0x02 0x01 0xbb 0x03 0x01>;
@@ -3775,7 +3780,7 @@
 			reset-names = "bus";
 			iommus = <0x33 0x1940 0x00 0x33 0x1947 0x00>;
 			dma-coherent;
-			status = "okay";
+			status = "disabled";
 			firmware-name = "qcom/x1p42100/Microsoft/Surface12/qcvss8380_pa.mbn";
 			phandle = <0x231>;
 
@@ -7121,7 +7126,7 @@
 			interrupts = <0x00 0x8a 0x01 0x00 0x86 0x01 0x00 0x88 0x01>;
 			interrupt-names = "eventq", "gerror", "cmdq-sync";
 			dma-coherent;
-			status = "reserved";
+			status = "okay";
 			phandle = <0x25b>;
 		};
 
@@ -7152,7 +7157,7 @@
 			reg = <0x00 0x17410000 0x00 0x1000>;
 			clocks = <0x29>;
 			interrupts = <0x00 0x00 0x01>;
-			status = "reserved";
+			status = "okay";
 			phandle = <0x25c>;
 		};
 
@@ -7701,6 +7706,7 @@
 		};
 
 		sbsa_watchdog: watchdog@1c840000 {
+			status = "disabled";
 			compatible = "arm,sbsa-gwdt";
 			reg = <0x00 0x1c840000 0x00 0x1000 0x00 0x1c850000 0x00 0x1000>;
 			interrupts = <0x00 0x00 0x04>;
@@ -7828,6 +7834,7 @@
 		};
 
 		remoteproc_cdsp: remoteproc@32300000 {
+			qcom,broken-reset;
 			compatible = "qcom,x1e80100-cdsp-pas";
 			reg = <0x00 0x32300000 0x00 0x10000>;
 			interrupts-extended = <0x01 0x00 0x242 0x01 0x17f 0x00 0x01 0x17f 0x01 0x01 0x17f 0x02 0x01 0x17f 0x03 0x01>;
