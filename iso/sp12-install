#!/bin/sh
# sp12-install — Installeur guidé SP12. Effacement ANSI (pas de binaire clear).
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
G=$(printf '\033[1;32m'); R=$(printf '\033[1;31m'); Y=$(printf '\033[1;33m'); C=$(printf '\033[1;36m'); Z=$(printf '\033[0m')
CLR(){ printf '\033[2J\033[3J\033[H'; }
hr(){ echo "----------------------------------------------------------------"; }
title(){ CLR; echo "${C}== Installeur Surface Pro 12 — Arch Linux ARM ==${Z}"; hr; }
die(){ echo "${R}!! $*${Z}"; echo "Entree pour un shell..."; read x; exec sh; }
ask(){ printf '%s%s: ' "$1" "${2:+ [$2]}" >&2; read r; [ -z "$r" ] && r="$2"; echo "$r"; }
askpw(){ while :; do printf '%s: ' "$1" >&2; stty -echo 2>/dev/null; read a; stty echo 2>/dev/null; echo >&2; printf '  confirmer: ' >&2; stty -echo 2>/dev/null; read b; stty echo 2>/dev/null; echo >&2; [ -n "$a" ] && [ "$a" = "$b" ] && { echo "$a"; return; }; echo "${Y}  vide/differe, reessaie${Z}" >&2; done; }
yesno(){ printf '%s (o/N): ' "$1"; read r; case "$r" in o|O|y|Y|oui) return 0;; *) return 1;; esac; }
exec </dev/tty0 >/dev/tty0 2>&1

# ---- localiser le payload ----
title; echo "Recherche du systeme a installer (payload)..."
PAYLOAD=""; SRC=/mnt/src; mkdir -p "$SRC"
for dev in $(blkid -o device 2>/dev/null); do
  mount -o ro "$dev" "$SRC" 2>/dev/null || mount.exfat-fuse -o ro "$dev" "$SRC" 2>/dev/null || continue
  p=$(ls "$SRC"/sp12-base-*.tar.zst 2>/dev/null | head -1)
  if [ -n "$p" ]; then PAYLOAD="$p"; echo "  trouve: $dev -> $(basename "$p")"; sleep 1; break; fi
  umount "$SRC" 2>/dev/null
done
[ -n "$PAYLOAD" ] || die "payload sp12-base-*.tar.zst introuvable"

# ============ CLAVIER (avant tout mot de passe) ============
select_keyboard() {
  while :; do
    # --- ETAPE 1 : choix ---
    title
    echo "CLAVIER (1/2) — Choisissez le numero correspondant a votre clavier,"
    echo "puis appuyez sur Entree :"
    hr
    echo "   1) Suisse romand   (fr_CH)        6) Allemand      (de)"
    echo "   2) Suisse allemand (de_CH)        7) Italien       (it)"
    echo "   3) Francais azerty (fr)           8) Espagnol      (es)"
    echo "   4) Belge           (be)           9) Royaume-Uni   (gb)"
    echo "   5) US qwerty       (us)"
    hr
    printf "Votre choix [1-9], Entree=1 : "; read n; [ -z "$n" ] && n=1
    case "$n" in
      1) KMAP=fr_CH;     KEYMAP=fr_CH;     XKBL=ch; XKBV=fr;;
      2) KMAP=de_CH;     KEYMAP=de_CH;     XKBL=ch; XKBV=de;;
      3) KMAP=fr;        KEYMAP=fr;        XKBL=fr; XKBV=;;
      4) KMAP=be-latin1; KEYMAP=be-latin1; XKBL=be; XKBV=;;
      5) KMAP=us;        KEYMAP=us;        XKBL=us; XKBV=;;
      6) KMAP=de-latin1; KEYMAP=de-latin1; XKBL=de; XKBV=;;
      7) KMAP=it;        KEYMAP=it;        XKBL=it; XKBV=;;
      8) KMAP=es;        KEYMAP=es;        XKBL=es; XKBV=;;
      9) KMAP=uk;        KEYMAP=uk;        XKBL=gb; XKBV=;;
      *) echo "${Y}  Tapez un chiffre entre 1 et 9.${Z}"; sleep 2; continue;;
    esac
    loadkeys "$KMAP" 2>/dev/null || loadkeys "$KEYMAP" 2>/dev/null
    # --- ETAPE 2 : test ---
    title
    echo "CLAVIER (2/2) — Disposition choisie : ${G}$KMAP${Z}"
    hr
    echo "Testez votre clavier ici. Tapez quelques caracteres (accents, @ - / z y),"
    echo "verifiez qu'ils correspondent bien a votre clavier, puis Entree :"
    printf "  Test > "; read t
    echo "  Vous avez tape : [${G}$t${Z}]"
    hr
    printf "Garder cette disposition ? [Entree=GARDER, ou 'n' pour changer] : "; read ok
    case "$ok" in n|N|non|no) continue;; *) break;; esac
  done
}
select_tz() {
  title
  echo "FUSEAU HORAIRE — choisis un numero :"
  echo "(l heure se synchronise via WiFi/NTP au 1er demarrage)"
  hr
  echo "   1) Europe/Zurich    (Suisse)        6) Europe/Madrid   (Espagne)"
  echo "   2) Europe/Paris     (France)        7) Europe/Rome     (Italie)"
  echo "   3) Europe/Brussels  (Belgique)      8) Europe/Lisbon   (Portugal)"
  echo "   4) Europe/Berlin    (Allemagne)     9) America/Montreal(Quebec)"
  echo "   5) Europe/London    (UK)           10) UTC"
  hr
  echo "   0) Autre (saisie manuelle)"
  hr
  printf "Votre choix [0-10], Entree=1 : " >&2; read n; [ -z "$n" ] && n=1
  case "$n" in
    1) TZ=Europe/Zurich;; 2) TZ=Europe/Paris;;  3) TZ=Europe/Brussels;;
    4) TZ=Europe/Berlin;; 5) TZ=Europe/London;; 6) TZ=Europe/Madrid;;
    7) TZ=Europe/Rome;;   8) TZ=Europe/Lisbon;; 9) TZ=America/Montreal;;
    10) TZ=UTC;;
    0) TZ=$(ask "Zone (ex: America/New_York)" "Europe/Zurich");;
    *) TZ=Europe/Zurich;;
  esac
}
select_keyboard

# ============ bienvenue ============
title
echo "Installe Arch Linux ARM (SP12) sur un disque. Le disque cible sera EFFACE."
echo "Rien n'est ecrit avant la confirmation (taper EFFACER)."
hr; yesno "Continuer ?" || exec sh

# ============ disque cible ============
title; echo "Disques detectes :"; hr
lsblk -dno NAME,SIZE,MODEL 2>/dev/null | grep -vE 'loop|ram|sr0'
hr
DISK=""
while [ -z "$DISK" ]; do d=$(ask "Disque cible (ex: sdc)"); [ -b "/dev/$d" ] && DISK="/dev/$d" || echo "${Y}  /dev/$d introuvable${Z}"; done

# ============ identite + MOTS DE PASSE ============
title; echo "Reglages :"; hr
HOSTNAME=$(ask "Hostname" "sp12")
USERNAME=$(ask "Utilisateur" "user")
echo "Mot de passe pour $USERNAME :"; USERPW=$(askpw "  mdp")
echo "Mot de passe root :"; ROOTPW=$(askpw "  mdp root")
select_tz
LOCALE=$(ask "Locale" "fr_CH.UTF-8")
AUTOL=no; yesno "Autologin (bureau direct) ?" && AUTOL=yes
SSID=""; PSK=""; if yesno "Configurer le WiFi ?"; then SSID=$(ask "SSID"); PSK=$(askpw "  mdp WiFi"); fi

# ============ confirmation ============
title; echo "${Y}RECAP${Z}"; hr
echo "  Cible EFFACEE : $DISK ($(lsblk -dno SIZE $DISK 2>/dev/null))"
echo "  Clavier=$KMAP  Host=$HOSTNAME  User=$USERNAME (autologin=$AUTOL)"
echo "  TZ=$TZ  Locale=$LOCALE  WiFi=${SSID:-aucun}"
hr; echo "${R}Tape EFFACER pour partitionner $DISK :${Z}"; read c
[ "$c" = "EFFACER" ] || die "Annule"

# ============ partition + format ============
title; echo "Partitionnement..."
sgdisk --zap-all "$DISK" >/dev/null 2>&1
sgdisk -n1:0:+512M -t1:ef00 -c1:EFI -n2:0:0 -t2:8300 -c2:SP12ROOT "$DISK" >/dev/null
sleep 2; partprobe "$DISK" 2>/dev/null; sleep 1
case "$DISK" in *nvme*|*mmcblk*) P1=${DISK}p1; P2=${DISK}p2;; *) P1=${DISK}1; P2=${DISK}2;; esac
mkfs.fat -F32 -n SYSTEM "$P1" >/dev/null
mkfs.ext4 -F -L SP12ROOT "$P2" >/dev/null

# ============ extraction payload ============
title; echo "Extraction du systeme (plusieurs minutes)..."
T=/mnt/target; mkdir -p "$T"; mount "$P2" "$T"
zstd -dc "$PAYLOAD" | tar -xp --xattrs --acls --numeric-owner -C "$T" || die "extraction echouee"
mkdir -p "$T/boot/efi"; mount "$P1" "$T/boot/efi"; sync
[ -e "$T/boot/Image" ] || die "kernel Image absent du payload"

# ============ fstab + boot ============
RUUID=$(blkid -s UUID -o value "$P2"); EUUID=$(blkid -s UUID -o value "$P1")
printf 'UUID=%s  /         ext4  rw,relatime        0 1\nUUID=%s   /boot/efi vfat  rw,noatime,nofail  0 2\n' "$RUUID" "$EUUID" > "$T/etc/fstab"
title; echo "Bootloader (GRUB + DTB)..."
mkdir -p "$T/boot/grub" "$T/boot/efi/EFI/sp12" "$T/boot/efi/EFI/BOOT"
cat > "$T/boot/grub/grub.cfg" <<EOF
set timeout=3
menuentry "Surface Pro 12 - Arch Linux ARM" {
    search --no-floppy --set=root --fs-uuid $RUUID
    linux /boot/Image root=UUID=$RUUID rw rootwait console=tty0 consoleblank=0 clk_ignore_unused pd_ignore_unused usbcore.autosuspend=-1
    initrd /boot/initramfs-sp12.img
    devicetree /boot/sp12.dtb
}
EOF
cp /sp12-target-efi/BOOTAA64.EFI "$T/boot/efi/EFI/sp12/BOOTAA64.EFI"
cp /sp12-target-efi/BOOTAA64.EFI "$T/boot/efi/EFI/BOOT/BOOTAA64.EFI"

# ============ config chroot ============
title; echo "Configuration..."
for d in dev proc sys run; do mkdir -p "$T/$d"; done
mount -o bind /dev "$T/dev"; mount -t proc proc "$T/proc"; mount -t sysfs sys "$T/sys"; mount -o bind /run "$T/run" 2>/dev/null
cat > "$T/root/.cfg.sh" <<CFG
#!/bin/bash
set -e
echo "$HOSTNAME" > /etc/hostname
ln -sf /usr/share/zoneinfo/$TZ /etc/localtime; hwclock --systohc 2>/dev/null || true
grep -q "^$LOCALE" /etc/locale.gen || echo "$LOCALE UTF-8" >> /etc/locale.gen
sed -i "s/^#\s*$LOCALE/$LOCALE/" /etc/locale.gen 2>/dev/null || true
locale-gen; echo "LANG=$LOCALE" > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf
mkdir -p /etc/X11/xorg.conf.d
printf 'Section "InputClass"\n Identifier "kbd"\n MatchIsKeyboard "on"\n Option "XkbLayout" "$XKBL"\n Option "XkbVariant" "$XKBV"\nEndSection\n' > /etc/X11/xorg.conf.d/00-keyboard.conf
id "$USERNAME" >/dev/null 2>&1 || useradd -m -G wheel,video,audio,network,storage,input -s /bin/bash "$USERNAME"
echo "$USERNAME:$USERPW" | chpasswd
echo "root:$ROOTPW" | chpasswd
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers
ssh-keygen -A
systemctl enable sshd systemd-timesyncd sddm sp12-audio-ucm sp12-typecover 2>/dev/null || true
CFG
chmod +x "$T/root/.cfg.sh"; chroot "$T" /bin/bash /root/.cfg.sh || die "config chroot echouee"; rm -f "$T/root/.cfg.sh"
if [ -n "$SSID" ]; then
  printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=1\nnetwork={\n ssid="%s"\n psk="%s"\n}\n' "$SSID" "$PSK" > "$T/etc/wpa_supplicant/wpa_supplicant-wlan0.conf"
  chroot "$T" systemctl enable wpa_supplicant@wlan0 dhcpcd 2>/dev/null || true
fi
[ "$AUTOL" = yes ] && { mkdir -p "$T/etc/sddm.conf.d"; printf '[Autologin]\nUser=%s\nSession=plasma\n' "$USERNAME" > "$T/etc/sddm.conf.d/autologin.conf"; }
efibootmgr -c -d "$DISK" -p 1 -L "SP12 Linux" -l '\EFI\sp12\BOOTAA64.EFI' 2>/dev/null || echo "${Y}  (fallback /EFI/BOOT utilise)${Z}"

# ============ fin ============
sync; umount "$T/boot/efi" 2>/dev/null; umount -l "$T/dev" "$T/proc" "$T/sys" "$T/run" 2>/dev/null; umount "$T" 2>/dev/null
title; echo "${G}Installation terminee !${Z}"; echo "Retire la cle, COLD BOOT. Comptes root + $USERNAME prets."
hr; yesno "Redemarrer ?" && reboot -f
echo "Tape 'reboot -f' quand tu veux."; exec sh
