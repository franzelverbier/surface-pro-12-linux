-	try_fmt->width = ov13858->cur_mode->width;
-	try_fmt->height = ov13858->cur_mode->height;
-	try_fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
-	try_fmt->field = V4L2_FIELD_NONE;
-
-	/* No crop or compose */
