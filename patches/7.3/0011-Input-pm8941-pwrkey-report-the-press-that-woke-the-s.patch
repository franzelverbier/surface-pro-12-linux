From d46d47143a93fd3f15738d16d967f1df029306de Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Fran=C3=A7ois=20Roux?= <franzelfranzel@gmail.com>
Date: Sun, 18 Oct 2026 18:34:20 +0200
Subject: [PATCH] Input: pm8941-pwrkey - report the press that woke the system
 as KEY_WAKEUP
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When the power key wakes the system from suspend, its interrupt is only
handled once the system is running again, and the press is reported as
KEY_POWER. Userspace takes it as a new power key press and, with the
common "suspend on power key" policy, puts the system straight back to
sleep. Waking up then takes two presses.

The ACPI button driver avoids this: it does not report presses while
suspended, and reports KEY_WAKEUP for a power button on resume.

Do the same here. Arm on suspend when the key may wake the system. If
the first event after resume comes within a short window, report it as
KEY_WAKEUP, and swallow the matching release. A release seen without its
press means the press itself was lost while suspended, so it is reported
as a full KEY_WAKEUP press and release. KEY_WAKEUP still counts as user
activity, so the screen comes back on. Later presses are reported as
KEY_POWER as before.

Tested on a Microsoft Surface Pro 12 (X1P42100, PMK8550 PON) with KDE
Plasma, which suspends on a power key press: before, every wake needed
two presses; with this change, a single press wakes the system and
leaves it running. In daily use since early October.

Assisted-by: LLM
Signed-off-by: François Roux <franzelfranzel@gmail.com>
---
 drivers/input/misc/pm8941-pwrkey.c | 52 ++++++++++++++++++++++++++++--
 1 file changed, 50 insertions(+), 2 deletions(-)

diff --git a/drivers/input/misc/pm8941-pwrkey.c b/drivers/input/misc/pm8941-pwrkey.c
index 53249d2c08..cedc195eb9 100644
--- a/drivers/input/misc/pm8941-pwrkey.c
+++ b/drivers/input/misc/pm8941-pwrkey.c
@@ -82,8 +82,15 @@ struct pm8941_pwrkey {
 	ktime_t sw_debounce_end_time;
 	bool last_status;
 	const struct pm8941_data *data;
+
+	/* Press that woke the system, reported as KEY_WAKEUP */
+	bool wake_armed;
+	bool wake_key_down;
+	ktime_t wake_window_end;
 };
 
+#define PM8941_WAKE_WINDOW_MS	1500
+
 static int pm8941_reboot_notify(struct notifier_block *nb,
 				unsigned long code, void *unused)
 {
@@ -171,6 +178,40 @@ static irqreturn_t pm8941_pwrkey_irq(int irq, void *_data)
 		pwrkey->sw_debounce_end_time = ktime_add_us(ktime_get(),
 						pwrkey->sw_debounce_time_us);
 
+	/*
+	 * The press that woke the system is delivered once it is running
+	 * again. Reported as KEY_POWER, userspace takes it as a new suspend
+	 * request and puts the system straight back to sleep. Report it as
+	 * KEY_WAKEUP instead: it still counts as user activity.
+	 */
+	if (pwrkey->wake_armed && pwrkey->wake_window_end &&
+	    ktime_after(ktime_get(), pwrkey->wake_window_end))
+		pwrkey->wake_armed = false;
+
+	if (pwrkey->wake_armed && (sts || !pwrkey->last_status)) {
+		pwrkey->wake_armed = false;
+		input_report_key(pwrkey->input, KEY_WAKEUP, 1);
+		input_sync(pwrkey->input);
+		if (sts) {
+			pwrkey->wake_key_down = true;
+		} else {
+			input_report_key(pwrkey->input, KEY_WAKEUP, 0);
+			input_sync(pwrkey->input);
+		}
+		pwrkey->last_status = sts;
+		return IRQ_HANDLED;
+	}
+
+	if (pwrkey->wake_key_down) {
+		if (!sts) {
+			pwrkey->wake_key_down = false;
+			input_report_key(pwrkey->input, KEY_WAKEUP, 0);
+			input_sync(pwrkey->input);
+		}
+		pwrkey->last_status = sts;
+		return IRQ_HANDLED;
+	}
+
 	/*
 	 * Simulate a press event in case a release event occurred without a
 	 * corresponding press event.
@@ -224,8 +265,11 @@ static int pm8941_pwrkey_suspend(struct device *dev)
 {
 	struct pm8941_pwrkey *pwrkey = dev_get_drvdata(dev);
 
-	if (device_may_wakeup(dev))
+	if (device_may_wakeup(dev)) {
 		enable_irq_wake(pwrkey->irq);
+		pwrkey->wake_armed = true;
+		pwrkey->wake_window_end = 0;
+	}
 
 	return 0;
 }
@@ -234,8 +278,11 @@ static int pm8941_pwrkey_resume(struct device *dev)
 {
 	struct pm8941_pwrkey *pwrkey = dev_get_drvdata(dev);
 
-	if (device_may_wakeup(dev))
+	if (device_may_wakeup(dev)) {
 		disable_irq_wake(pwrkey->irq);
+		pwrkey->wake_window_end = ktime_add_ms(ktime_get(),
+						       PM8941_WAKE_WINDOW_MS);
+	}
 
 	return 0;
 }
@@ -334,6 +381,7 @@ static int pm8941_pwrkey_probe(struct platform_device *pdev)
 	}
 
 	input_set_capability(pwrkey->input, EV_KEY, pwrkey->code);
+	input_set_capability(pwrkey->input, EV_KEY, KEY_WAKEUP);
 
 	pwrkey->input->name = pwrkey->data->name;
 	pwrkey->input->phys = pwrkey->data->phys;
-- 
